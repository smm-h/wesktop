{
  "changelog_format_version_enforced": true,
  "targets": [
    "pypi",
    "npm"
  ],
  "publish_mode": "ci",
  "push_timeout": 120,
  "pipelines": {
    "pypi": {
      "type": "pypi",
      "local": false,
      "target": "pypi"
    },
    "npm": {
      "type": "npm",
      "local": false,
      "provenance": true,
      "target": "npm"
    }
  },
  "batch_limits": {
    "exclusions": []
  }
}
